#!/bin/bash
# yuzora: wraps a built herdr-app binary as Yuzora.app (bundle id
# dev.yuuzu.yuzora, Yuzora's icon) for local runs and checks. Not a release
# package: L7 owns packaging, signing and the update channel.
#
#   scripts/yuzora/bundle-macos <out-dir> [path/to/herdr-app]
#
# The binary defaults to $CARGO_TARGET_DIR (or target)/debug/herdr-app.
set -euo pipefail

[[ $(uname -s) == Darwin ]] || { echo 'bundle-macos needs macOS.' >&2; exit 1; }
here=$(cd "$(dirname "$0")/../.." && pwd)
out=${1:?usage: bundle-macos <out-dir> [binary]}
bin=${2:-${CARGO_TARGET_DIR:-$here/target}/debug/herdr-app}
[[ -x $bin ]] || { echo "no binary at $bin (cargo build first)" >&2; exit 1; }
version=$(sed -n 's/^version = "\(.*\)"/\1/p' "$here/Cargo.toml" | head -1)

app="$out/Yuzora.app"
rm -rf "$app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
cp "$bin" "$app/Contents/MacOS/Yuzora"
cp "$here/assets/icons/Yuzora.icns" "$app/Contents/Resources/Yuzora.icns"
cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleExecutable</key><string>Yuzora</string>
    <key>CFBundleIdentifier</key><string>dev.yuuzu.yuzora</string>
    <key>CFBundleName</key><string>Yuzora</string>
    <key>CFBundleDisplayName</key><string>Yuzora</string>
    <key>CFBundleIconFile</key><string>Yuzora</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>$version</string>
    <key>CFBundleVersion</key><string>$version</string>
    <key>NSMicrophoneUsageDescription</key><string>Terminal programs running in Yuzora can use the microphone, for example for voice input.</string>
    <key>NSCameraUsageDescription</key><string>Terminal programs running in Yuzora can use the camera.</string>
    <key>NSAppleEventsUsageDescription</key><string>Terminal programs running in Yuzora can use AppleScript to control other apps.</string>
    <key>NSPrincipalClass</key><string>NSApplication</string>
    <key>NSHighResolutionCapable</key><true/>
</dict></plist>
PLIST
codesign --force --sign - "$app" >/dev/null 2>&1 || true
echo "$app"
