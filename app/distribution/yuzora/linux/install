#!/bin/sh
# yuzora(L7): installs the Yuzora folder this script is in, for you only:
#
#   tar -xzf yuzora-<version>-linux-<arch>.tar.gz && yuzora/install
#
# The app goes to ~/.local/share/yuzora (what it updates in place, see
# src/update.rs), `yuzora` to ~/.local/bin, plus a launcher entry and icon
# under the Wayland/X11 app id dev.yuuzu.yuzora. Running it again from a newer
# folder replaces the app; an open one keeps running until it quits. Your
# data in ~/.config/yuzora stays. herdr-core is not installed here: Yuzora
# offers it when it opens.
set -eu

here=$(cd "$(dirname "$0")" && pwd)
data=${XDG_DATA_HOME:-$HOME/.local/share}
home="$data/yuzora"
bin="$HOME/.local/bin"
id=dev.yuuzu.yuzora

[ "$(uname -s)" = Linux ] || { echo "yuzora: this installer is for Linux" >&2; exit 1; }
[ -x "$here/yuzora" ] || { echo "yuzora: no yuzora program next to this script" >&2; exit 1; }

entry="$data/applications/$id.desktop"

mkdir -p "$data" "$bin" "$data/applications" "$data/icons/hicolor/512x512/apps"
if [ "$here" != "$home" ]; then
  # The whole folder is replaced, so only a new (or empty) one, or the one
  # this script installed into, as its launcher entry says.
  if [ -n "$(ls -A "$home" 2>/dev/null)" ] && ! grep -qxF "Exec=\"$home/yuzora\"" "$entry" 2>/dev/null; then
    echo "yuzora: $home is there and isn't a Yuzora install, so nothing was changed" >&2
    exit 1
  fi
  # A fresh folder to copy into (not $home.new: the app stages its updates there).
  stage=$(mktemp -d "$data/.yuzora-install.XXXXXX")
  chmod 755 "$stage"
  trap 'rm -rf "$stage"' EXIT
  cp -R "$here/." "$stage"
  rm -rf "$home"
  mv "$stage" "$home"
fi
# Only a link to a Yuzora folder (or nothing) is replaced, never your own `yuzora`.
link="$bin/yuzora"
if [ ! -e "$link" ] && [ ! -L "$link" ]; then
  ln -s "$home/yuzora" "$link"
elif [ -L "$link" ] && case $(readlink "$link") in */yuzora/yuzora) true ;; *) false ;; esac; then
  ln -sfn "$home/yuzora" "$link"
else
  echo "yuzora: $link isn't Yuzora's link, so it was left as it is; the app is $home/yuzora" >&2
fi
cp "$home/yuzora.png" "$data/icons/hicolor/512x512/apps/$id.png"
cat > "$entry" <<EOF
[Desktop Entry]
Type=Application
Name=Yuzora
Comment=AI coding agent workspace
Exec="$home/yuzora"
Icon=$id
Terminal=false
Categories=Development;
StartupWMClass=$id
EOF
command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$data/applications" 2>/dev/null || true
# A stale icon cache hides new icons until it's rebuilt.
[ -f "$data/icons/hicolor/icon-theme.cache" ] && gtk-update-icon-cache -f -t "$data/icons/hicolor" >/dev/null 2>&1 || true

echo "Yuzora is installed. Open it from your apps, or run: yuzora"
case ":$PATH:" in
  *":$bin:"*) ;;
  *) echo "Add $bin to your PATH to run yuzora from a terminal." ;;
esac
