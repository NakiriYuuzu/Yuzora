+// Archive bytes gain authority only after matching an independently reviewed
+// download digest. Never derive the expected download digest from these bytes.
+export function verifiedExecutableSha256(
+  archive: Uint8Array, expectedArchiveSha256: string,
+  unpack: "gz" | "zip" | "bare", executable: string
+): string {
+  if (!/^[a-f0-9]{64}$/i.test(expectedArchiveSha256) || sha256(archive) !== expectedArchiveSha256.toLowerCase()) {
+    throw new Error("archive SHA256 mismatch")
+  }
+  const bytes = unpack === "bare" ? archive : unpack === "gz"
+    ? gunzipSync(archive, { maxOutputLength: 100 * 1024 * 1024 })
+    : unzipSync(archive, {
+      filter: (entry) => entry.name === executable
+        && entry.originalSize > 0 && entry.originalSize <= 100 * 1024 * 1024,
+    })[executable]
+  if (!bytes) throw new Error("ZIP is missing a valid executable")
+  return sha256(bytes)
+}
