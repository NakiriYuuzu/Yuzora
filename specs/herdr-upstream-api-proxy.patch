+/// Proxy the public Herdr NDJSON API over stdin/stdout.
+///
+/// Requests are the unmodified public API `Request` JSON values, one per stdin
+/// line. Ordinary API responses are emitted verbatim on stdout. A streaming
+/// `events.subscribe` acknowledgement is likewise emitted verbatim; subsequent
+/// subscription events use a minimal envelope so independently subscribed
+/// streams remain correlatable after multiplexing:
+///
+/// `{ "type": "proxy.event", "request_id": "<request id>", "event": <public event> }`
+///
+/// stderr is reserved for diagnostics. No socket path can be supplied here:
+/// selection is still controlled by Herdr's established `--session` flag or
+/// `HERDR_SESSION` environment variable.
+fn run_proxy_command(args: &[String]) -> std::io::Result<i32> {
+    match args {
+        [flag] if flag == "--stdio" => run_stdio_proxy(),
+        [flag] if matches!(flag.as_str(), "help" | "--help" | "-h") => {
+            print_proxy_help();
+            Ok(0)
+        }
+        _ => {
+            print_proxy_help();
+            Ok(2)
+        }
+    }
+}
+
+fn run_stdio_proxy() -> std::io::Result<i32> {
+    let output: ProxyOutput = Arc::new(Mutex::new(Box::new(io::stdout())));
+    let stdin = io::stdin();
+    let mut reader = BufReader::new(stdin.lock());
+    let request_handler: ProxyRequestHandler =
+        Arc::new(|request| ApiClient::local().request_value(&request));
+    let subscription_handler: ProxySubscriptionHandler = Arc::new(proxy_events_subscribe);
+    run_stdio_proxy_with(&mut reader, output, request_handler, subscription_handler)
+}
+
+/// Deterministic stdio-proxy coordinator. Production passes the local public
+/// API client; unit tests pass an in-memory handler to cover request ordering,
+/// duplicate IDs, EOF and stdout serialization without a private transport.
+fn run_stdio_proxy_with<R: BufRead>(
+    reader: &mut R,
+    output: ProxyOutput,
+    request_handler: ProxyRequestHandler,
+    subscription_handler: ProxySubscriptionHandler,
+) -> std::io::Result<i32> {
+    let active_ids = Arc::new(Mutex::new(HashMap::new()));
+    loop {
+        let Some(line) = read_proxy_line(reader)? else {
+            return finish_proxy_on_eof(&active_ids);
+        };
+        let trimmed = line.trim();
+        if trimmed.is_empty() {
+            continue;
+        }
+
+        let request = match serde_json::from_str::<Request>(trimmed) {
+            Ok(request) => request,
+            Err(error) => {
+                write_proxy_line(
+                    &output,
+                    &proxy_error("", "invalid_request", format!("invalid request: {error}")),
+                )?;
+                continue;
+            }
+        };
+        if request.id.trim().is_empty() {
+            write_proxy_line(
+                &output,
+                &proxy_error("", "invalid_request", "request id must not be empty"),
+            )?;
+            continue;
+        }
+        let request_id = request.id.clone();
+        let is_streaming = matches!(&request.method, Method::EventsSubscribe(_));
+        let inserted = {
+            let mut ids = active_ids.lock().map_err(proxy_lock_error)?;
+            if ids.contains_key(&request_id) {
+                false
+            } else {
+                ids.insert(request_id.clone(), is_streaming);
+                true
+            }
+        };
+        if !inserted {
+            write_proxy_line(
+                &output,
+                &proxy_error(
+                    &request_id,
+                    "duplicate_request_id",
+                    "a request with this id is still active",
+                ),
+            )?;
+            continue;
+        }
+
+        let output_for_request = Arc::clone(&output);
+        let active_ids_for_request = Arc::clone(&active_ids);
+        let request_handler = Arc::clone(&request_handler);
+        let subscription_handler = Arc::clone(&subscription_handler);
+        std::thread::spawn(move || {
+            let result = if matches!(&request.method, Method::EventsSubscribe(_)) {
+                subscription_handler(request, &output_for_request)
+            } else {
+                proxy_request_with(request, &output_for_request, request_handler)
+            };
+            if let Err(error) = result {
+                // The request id is still known even if the underlying socket
+                // fails before it can emit a public response.
+                let _ = write_proxy_line(
+                    &output_for_request,
+                    &proxy_error(&request_id, "proxy_io", error.to_string()),
+                );
+            }
+            if let Ok(mut ids) = active_ids_for_request.lock() {
+                ids.remove(&request_id);
+            }
+        });
+    }
+}
+
+/// EOF should let ordinary requests flush their responses, but it must not
+/// wait forever for a subscription stream. Process exit then closes only this
+/// bridge's socket connections.
+fn finish_proxy_on_eof(active_ids: &ProxyActiveIds) -> io::Result<i32> {
+    let deadline = std::time::Instant::now() + std::time::Duration::from_secs(5);
+    loop {
+        let waiting_on_normal_request = active_ids
+            .lock()
+            .map_err(proxy_lock_error)?
+            .values()
+            .any(|streaming| !streaming);
+        if !waiting_on_normal_request || std::time::Instant::now() >= deadline {
+            return Ok(0);
+        }
+        std::thread::sleep(std::time::Duration::from_millis(10));
+    }
+}
+
+fn proxy_request_with(
+    request: Request,
+    output: &ProxyOutput,
+    request_handler: ProxyRequestHandler,
+) -> io::Result<()> {
+    match request_handler(request.clone()) {
+        Ok(response) => write_proxy_line(output, &response),
+        Err(error) => write_proxy_line(
+            output,
+            &proxy_error(&request.id, "proxy_io", error.to_string()),
+        ),
+    }
+}
+
+fn proxy_events_subscribe(request: Request, output: &ProxyOutput) -> io::Result<()> {
+    use interprocess::local_socket::traits::Stream as _;
+
+    let socket = crate::api::socket_path();
+    let mut stream = crate::ipc::connect_local_stream(&socket)?;
+    let encoded = serde_json::to_vec(&request)
+        .map_err(|error| io::Error::other(format!("encode proxy request: {error}")))?;
+    if encoded.len() > PROXY_MAX_LINE_BYTES {
+        return write_proxy_line(
+            output,
+            &proxy_error(
+                &request.id,
+                "invalid_request",
+                "request exceeds the proxy NDJSON size limit",
+            ),
+        );
+    }
+    stream.write_all(&encoded)?;
+    stream.write_all(b"\n")?;
+    stream.flush()?;
+
+    let mut reader = BufReader::new(stream);
+    let Some(ack) = read_proxy_line(&mut reader)? else {
+        return write_proxy_line(
+            output,
+            &proxy_error(
+                &request.id,
+                "server_unavailable",
+                "socket closed before subscription acknowledgement",
+            ),
+        );
+    };
+    let ack: serde_json::Value = serde_json::from_str(ack.trim()).map_err(|error| {
+        io::Error::new(
+            io::ErrorKind::InvalidData,
+            format!("subscription acknowledgement is not JSON: {error}"),
+        )
+    })?;
+    write_proxy_line(output, &ack)?;
+    if ack.get("error").is_some() {
+        return Ok(());
+    }
+
+    while let Some(line) = read_proxy_line(&mut reader)? {
+        let trimmed = line.trim();
+        if trimmed.is_empty() {
+            continue;
+        }
+        let event: serde_json::Value = serde_json::from_str(trimmed).map_err(|error| {
+            io::Error::new(
+                io::ErrorKind::InvalidData,
+                format!("subscription event is not JSON: {error}"),
+            )
+        })?;
+        write_proxy_line(
+            output,
+            &serde_json::json!({
+                "type": "proxy.event",
+                "request_id": request.id,
+                "event": event,
+            }),
+        )?;
+    }
+
+    write_proxy_line(
+        output,
+        &serde_json::json!({
+            "type": "proxy.disconnected",
+            "request_id": request.id,
+            "reason": "api socket closed",
+        }),
+    )
+}
+
+fn read_proxy_line<R: BufRead>(reader: &mut R) -> io::Result<Option<String>> {
+    let mut bytes = Vec::new();
+    let mut limited = reader.take((PROXY_MAX_LINE_BYTES + 2) as u64);
+    let read = limited.read_until(b'\n', &mut bytes)?;
+    if read == 0 {
+        return Ok(None);
+    }
+    let terminated = bytes.last() == Some(&b'\n');
+    let content_len = if terminated {
+        bytes.len().saturating_sub(1)
+    } else {
+        bytes.len()
+    };
+    if content_len > PROXY_MAX_LINE_BYTES {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "proxy NDJSON line exceeds 1 MiB",
+        ));
+    }
+    String::from_utf8(bytes)
+        .map(Some)
+        .map_err(|error| io::Error::new(io::ErrorKind::InvalidData, error))
+}
+
+fn write_proxy_line(output: &ProxyOutput, value: &serde_json::Value) -> io::Result<()> {
+    let encoded = serde_json::to_vec(value)
+        .map_err(|error| io::Error::other(format!("encode proxy response: {error}")))?;
+    if encoded.len() > PROXY_MAX_LINE_BYTES {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "proxy response exceeds 1 MiB",
+        ));
+    }
+    let mut stdout = output.lock().map_err(proxy_lock_error)?;
+    stdout.write_all(&encoded)?;
+    stdout.write_all(b"\n")?;
+    stdout.flush()
+}
+
+fn proxy_error(
+    id: impl AsRef<str>,
+    code: impl Into<String>,
+    message: impl Into<String>,
+) -> serde_json::Value {
+    serde_json::json!({
+        "id": id.as_ref(),
+        "error": {
+            "code": code.into(),
+            "message": message.into(),
+        }
+    })
+}
+
+fn proxy_lock_error<T>(_: std::sync::PoisonError<T>) -> io::Error {
+    io::Error::other("stdio proxy output lock poisoned")
+}
+
 fn write_schema_file(path: &std::path::Path) -> std::io::Result<()> {
     std::fs::write(path, API_SCHEMA_JSON)
 }
